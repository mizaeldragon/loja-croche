// Schema da landing page + painel do Ateliê Angel Art.
// Banco: Postgres (Railway). Valores monetários em Decimal(10,2) — nunca Float.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- catálogo

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  order       Int       @default(0)
  products    Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ProductStatus {
  draft
  published
}

model Product {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String        @default("")
  price       Decimal       @db.Decimal(10, 2)
  // Preço promocional. Quando preenchido e menor que `price`, é o valor exibido.
  promoPrice  Decimal?      @db.Decimal(10, 2)
  status      ProductStatus @default(draft)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  images String[] @default([])
  colors String[] @default([])
  sizes  String[] @default([])
  tags   String[] @default([])

  featured   Boolean @default(false)
  bestseller Boolean @default(false)
  isNew      Boolean @default(false)
  stock      Int     @default(0)
  order      Int     @default(0)

  seoTitle       String?
  seoDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, order])
  @@index([categoryId])
}

// ---------------------------------------------------------------- orçamentos

enum QuoteStatus {
  novo
  em_andamento
  respondido
  fechado
}

// Pedido de orçamento vindo do formulário da landing page: só um contato e o
// que a pessoa quer.
model Quote {
  id      String      @id @default(cuid())
  number  Int         @unique @default(autoincrement())
  name    String
  // O formulário da landing pede um contato só (e-mail OU telefone), então
  // os dois são opcionais aqui — a rota exige que ao menos um venha.
  email   String?
  phone   String?
  message String      @default("")
  status  QuoteStatus @default(novo)
  notes   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

// ---------------------------------------------------------------- admin

enum AdminRole {
  admin
  editor
}

model AdminUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(editor)
  avatar       String?
  active       Boolean   @default(true)
  lastLoginAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------- conteúdo

model Testimonial {
  id      String  @id @default(cuid())
  name    String
  role    String?
  text    String
  rating  Int     @default(5)
  avatar  String?
  visible Boolean @default(true)
  order   Int     @default(0)

  createdAt DateTime @default(now())
}

model Faq {
  id       String  @id @default(cuid())
  question String
  answer   String
  order    Int     @default(0)
  visible  Boolean @default(true)
}

// Conteúdo editorial do site em documento único (id fixo "default").
// `data` espelha seedSettings e `banners` espelha seedBanners (hero,
// carousel e promo) — estruturas aninhadas que o painel edita como bloco,
// então JSON encaixa melhor do que tabela.
model Settings {
  id      String @id @default("default")
  data    Json
  banners Json   @default("{}")

  updatedAt DateTime @updatedAt
}
