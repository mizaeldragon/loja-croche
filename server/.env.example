# Copie para .env e preencha. NUNCA versione o .env real.
#
# Aqui só entra configuração de INFRAESTRUTURA — o que muda de instalação para
# instalação. As credenciais do Mercado Pago e do Melhor Envio NÃO ficam aqui:
# são da lojista, ficam cifradas no banco e ela configura pelo próprio painel,
# em Configurações → Integrações.

# ---- Banco (o Railway injeta automaticamente ao adicionar o Postgres) ----
# Atenção: se a senha tiver @ # ? / : ela precisa ser percent-encoded.
DATABASE_URL="postgresql://usuario:senha@localhost:5432/loja?schema=public"

# ---- App ----
PORT=3333
NODE_ENV=development
# Origens liberadas no CORS, separadas por vírgula (a URL do site na Vercel)
CORS_ORIGINS="http://localhost:5173"
# URL pública do site — para onde o Mercado Pago devolve o cliente após o pagamento
PUBLIC_SITE_URL="http://localhost:5173"

# ---- Segredos da instalação ----
# Ambos são gerados com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Assina as sessões do painel. Trocar = derrubar todo mundo que está logado.
JWT_SECRET=""

# Cifra os tokens das integrações guardados no banco (AES-256-GCM).
# Precisa ter exatamente 64 caracteres hexadecimais.
# Se for perdida ou trocada, a lojista precisa colar os tokens de novo.
CREDENTIALS_KEY=""

# ---- Primeiro acesso ao painel (usado só pelo seed) ----
# Depois do primeiro login, a senha pode ser trocada dentro do painel.
SEED_ADMIN_EMAIL="contato@sualoja.com.br"
SEED_ADMIN_PASSWORD=""
